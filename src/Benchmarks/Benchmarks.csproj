<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <NoWarn>SYSLIB5007</NoWarn>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <SystemPackageVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.12</SystemPackageVersion>
        <SystemPackageVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.100</SystemPackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(UseRuntimeAsync)' != 'false'">
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" />
      <PackageReference Include="HL7-V2" />
      <PackageReference Include="nhapi" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FastHl7\FastHl7.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Sample-ORM.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
